params {
    b0_threshold = 100
    topup_config = 'b02b0.cnf'
    topup_forward_phase_encoding = 'j'
    topup_forward_readout = 0.01536
    topup_reverse_phase_encoding = 'j-'
    topup_reverse_readout = 0.01536
    drop_processed_subject = null
}
process {
    cpus = 2
    withName: PREPROC_TOPUP {
        ext.prefix_topup = 'topup_results'
        ext.b0_thr_extract_b0 = params.b0_threshold
        ext.run_qc = false
    }
    withName: PREPROC_EDDY {
        ext.prefix_topup = 'topup_results'
        ext.b0_thr_extract_b0 = params.b0_threshold
        ext.bet_topup_before_eddy_f = 0.16
        ext.eddy_cmd = 'eddy_cpu'
        ext.extra_args = '--niter=1 --nvoxhp=100'
        ext.run_qc = false
    }
}
